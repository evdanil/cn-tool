[api]
endpoint = https://infoblox.example.com
verify_ssl = true
timeout = 10

[logging]
logfile = ~/cn.log
# Supported levels: DEBUG, INFO, WARNING, ERROR
# level = INFO

[report]
filename = ~/report.xlsx
auto_save = true
# lock_timeout = 120
# max_config_tab_kb = 512

[config_repo]
# directory = /opt/data/configs
vendors = cisco,aruba,f5,bluecoat,viptela
regions =
excluded_dirs = old,history
history_dir = history

[gpg]
# credentials = ~/cn-tool.gpg

[cache]
enabled = true
directory = ~/.cn-cache
version = 6
# check_workers = 4
# index_workers = 4
# index_executor = thread
# index_queue_size = 128
# index_batch_size = 256
# index_skip_keyword_vendors = paloalto

[theme]
# theme = default

[ssh]
# OpenSSH config used for host aliases and ProxyJump bastions; set blank to disable.
config_file = ~/.ssh/config
# Only query devices whose reverse-DNS name matches this regex (empty = query every host).
# device_name_filter = (sw|rtr|core)\d+

[site]
# Site-code conventions are organisation-specific; everything here is optional.
# code_pattern: regex a site code must match (case-insensitive). Default: 2-64 letters,
#   digits, '.', '_' or '-'.
# code_pattern = ^[A-Za-z0-9]{3}(?:-[A-Za-z0-9]{1,4})?$
# ea_name: Infoblox extensible attribute that holds the site code; when set, site search uses it
#   and searches subnet comments only when no subnet carries it. Default: empty (subnet
#   comments only). "cn doctor" checks that the attribute exists on the grid.
# ea_name = Site
# comment_pattern: regex template matched against Infoblox subnet comments, {site} is the
#   escaped site code. Default: the code as a whole word anywhere in the comment. Example
#   for comments laid out as "COUNTRY;SITE;description":
# comment_pattern = ^[^;]+;\s*{site}\s*(;|$)
# hostname_pattern: regex template used by the demobilisation check to find a site's devices
#   in configuration files. Placeholders: {site}, {site_compact} (hyphens removed) and
#   {country} (first two letters of the first subnet comment). Default: names starting with
#   the site code.
# hostname_pattern = \b{country}{site_compact}[-_\w]*\b

[ad]
# enabled = true
uri = ldap://your-ad-server.example.com
user = your-user@example.com or domain\login
search_base = CN=Subnets,CN=Sites,CN=Configuration,DC=example,DC=com
# operation_timeout = 15
# connect_on_startup = false

[email]
# enabled = true
send_on_exit = false
to = some_user@example.com
# from = cn-tool@localhost
# subject = CN-Tool Execution Report
# server = smtp.example.com
# port = 587
# use_tls = true
# use_ssl = false
# use_auth = true
# user = my_account@example.com
# password = app-password-or-service-password

[sdwan_yaml_search]
enabled = false
# repository_paths = /path/to/repo1,/path/to/repo2

[config_analyzer]
# repo_directories: where the repository browser (menu c) and "cn diff" read configurations.
#   Unset, [config_repo] directory is used.
# repo_directories = /path/to/repoA,/path/to/repoB
# repo_names = repoA,repoB
# layout = right
# scroll_to_end = false
# debug = false
